# ─────────────────────────────────────────────────────────────────
# Job Pack — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────────

# ── Backend selector ─────────────────────────────────────────────
# Options: 'ollama' (default) | 'claude'
LLM_BACKEND=ollama

# ── Ollama settings (used when LLM_BACKEND=ollama) ───────────────
# Class hosted endpoint:
OLLAMA_BASE_URL=http://your-class-ollama-host:11434
OLLAMA_MODEL=llama3
# Your student API key for the class endpoint (leave blank for local Ollama):
OLLAMA_API_KEY=

# ── Claude API settings (used when LLM_BACKEND=claude) ───────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# ── App settings ──────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false
DB_PATH=drafts.db
